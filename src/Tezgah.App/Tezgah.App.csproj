<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tezgah.Core\Tezgah.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Tezgah</AssemblyName>
    <RootNamespace>Tezgah.App</RootNamespace>
    <ApplicationIcon>Assets\tezgah.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Application.ThemeMode (Fluent theme) is marked experimental in the WPF API surface. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\tezgah.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tezgah.App.Tests" />
  </ItemGroup>

</Project>
