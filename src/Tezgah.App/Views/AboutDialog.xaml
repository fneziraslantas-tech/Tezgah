<Window x:Class="Tezgah.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tezgah.App.ViewModels"
        xmlns:views="clr-namespace:Tezgah.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
        Style="{StaticResource DialogWindow}" Width="680" Title="{DynamicResource About_Title}">
    <Window.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SafetyIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,12,0" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,18">
                <!-- name, logo, version, summary -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:LogoImage Width="56" Height="56" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tezgah" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{DynamicResource About_Summary}" TextWrapping="Wrap" LineHeight="20" Margin="0,16,0,0" FontSize="13.5" />

                <!-- how to use -->
                <TextBlock Text="{DynamicResource About_HowTo}" Style="{StaticResource Caption}" Margin="0,18,0,8" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,2,0,6" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Grid.Resources>

                    <Border Grid.Row="0" Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource About_HowScan}" FontWeight="SemiBold" Margin="0,2,14,6" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource About_HowScan_Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Border Grid.Row="1" Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource About_HowSelect}" FontWeight="SemiBold" Margin="0,2,14,6" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource About_HowSelect_Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Border Grid.Row="2" Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource About_HowRun}" FontWeight="SemiBold" Margin="0,2,14,6" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource About_HowRun_Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Border Grid.Row="3" Style="{StaticResource StepNumber}"><TextBlock Text="4" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource About_HowClean}" FontWeight="SemiBold" Margin="0,2,14,6" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{DynamicResource About_HowClean_Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Border Grid.Row="4" Style="{StaticResource StepNumber}"><TextBlock Text="5" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource About_HowRemove}" FontWeight="SemiBold" Margin="0,2,14,6" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{DynamicResource About_HowRemove_Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- safety -->
                <TextBlock Text="{DynamicResource About_Safety}" Style="{StaticResource Caption}" Margin="0,14,0,8" />
                <Border Style="{StaticResource Card}" Padding="14,12,14,4">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                            </Style>
                        </StackPanel.Resources>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource SafetyIcon}" />
                            <TextBlock Text="{DynamicResource About_Safety_Trust}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE890;" Style="{StaticResource SafetyIcon}" />
                            <TextBlock Text="{DynamicResource About_Safety_Inspect}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE74D;" Style="{StaticResource SafetyIcon}" />
                            <TextBlock Text="{DynamicResource About_Safety_Recycle}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE765;" Style="{StaticResource SafetyIcon}" />
                            <TextBlock Text="{DynamicResource About_Safety_Typed}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE9D9;" Style="{StaticResource SafetyIcon}" />
                            <TextBlock>
                                <Run Text="{DynamicResource About_Safety_Audit}" />
                                <Run Text="%LOCALAPPDATA%\Tezgah\audit.log" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- shortcuts -->
                <TextBlock Text="{DynamicResource About_Shortcuts}" Style="{StaticResource Caption}" Margin="0,16,0,8" />
                <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShortcutRow}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                <Border Style="{StaticResource Badge}" MinWidth="50" Margin="0,0,8,0" Padding="6,1,6,2">
                                    <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Action}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <Border Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,4,0"
                            ToolTip="{x:Static vm:AboutViewModel.RepositoryUrl}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="{DynamicResource About_Repository}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding OpenLicenseCommand}" Margin="0,0,4,0"
                            ToolTip="{x:Static vm:AboutViewModel.LicenseUrl}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="{DynamicResource About_License}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding OpenLogFolderCommand}" ToolTip="{Binding LogDirectory}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="{DynamicResource About_OpenLogs}" /></StackPanel>
                    </Button>
                </WrapPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Common_Close}" MinWidth="96" IsDefault="True" IsCancel="True"
                        Command="{Binding CloseCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
