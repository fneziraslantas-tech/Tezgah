<Window x:Class="Tezgah.App.Views.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tezgah.App.ViewModels"
        xmlns:model="clr-namespace:Tezgah.Core.Model;assembly=Tezgah.Core"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:UninstallViewModel}"
        Style="{StaticResource DialogWindow}" Width="640" Title="{Binding Title}">
    <StackPanel>
        <StackPanel Margin="24,22,24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,12" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}" />
            </StackPanel>

            <!-- loading -->
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,8">
                <TextBlock Text="{DynamicResource Uninstall_Planning}" Style="{StaticResource Muted}" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />

            <!-- warnings -->
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:PlanWarning}">
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static model:WarningLevel.Warning}">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static model:WarningLevel.Danger}">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static model:WarningLevel.Blocker}">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Level, Converter={StaticResource IconGlyph}}" Margin="0,1,10,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static model:WarningLevel.Warning}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static model:WarningLevel.Danger}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static model:WarningLevel.Blocker}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- steps -->
            <TextBlock Text="{DynamicResource Uninstall_Steps}" Style="{StaticResource Caption}" Margin="0,4,0,6"
                       Visibility="{Binding Steps.Count, Converter={StaticResource CountToVis}}" />
            <Border Style="{StaticResource Card}" Padding="6" Visibility="{Binding Steps.Count, Converter={StaticResource CountToVis}}">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UninstallStepViewModel}">
                                <Grid Margin="6,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsLocked, Converter={StaticResource InvBool}}"
                                              VerticalAlignment="Top" Margin="0,0,4,0" MinWidth="0"
                                              ToolTip="{DynamicResource Uninstall_StepLocked}" ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind, Converter={StaticResource IconGlyph}}" Style="{StaticResource Icon}"
                                               VerticalAlignment="Top" Margin="0,3,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Detail}"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Muted}" Margin="12,2,4,0" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,8,4,0"
                       Visibility="{Binding Steps.Count, Converter={StaticResource CountToVis}}" />

            <!-- typed confirmation -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding RequiresTypedConfirmation, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="TypePromptText" Text="{Binding TypePrompt}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="ConfirmBox" Text="{Binding TypedText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.LabeledBy="{Binding ElementName=TypePromptText}"
                         IsEnabled="{Binding IsDone, Converter={StaticResource InvBool}}" />
            </StackPanel>

            <!-- progress / result -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" />
            </StackPanel>
            <Border CornerRadius="6" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Outcomes}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:StepOutcome}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,2,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE711;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Step.Description}" FontSize="12" />
                                    <TextBlock Text="{Binding Error}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock Text="{Binding BlockReason}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="340" HorizontalAlignment="Left" FontSize="12"
                           Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0" MinWidth="96" IsCancel="True" IsDefault="True"
                            Command="{Binding CloseCommand}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Common_Cancel}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Common_Close}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" MinWidth="120" Command="{Binding ExecuteCommand}"
                            Visibility="{Binding IsDone, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Uninstall_Confirm}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
