<Window x:Class="Tezgah.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" Width="460" Title="Tezgah">
    <StackPanel>
        <StackPanel Margin="24,22,24,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,12" VerticalAlignment="Top" />
                <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" />
            </StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" />
        </StackPanel>
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" MinWidth="96" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="96" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
