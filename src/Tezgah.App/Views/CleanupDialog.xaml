<Window x:Class="Tezgah.App.Views.CleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tezgah.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
        Style="{StaticResource DialogWindow}" Width="580" Title="{Binding Title}">
    <StackPanel>
        <StackPanel Margin="24,22,24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE75C;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,12" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Cleanup_Explain}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding PermanentDelete, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource Cleanup_Permanent}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="6">
                <ItemsControl ItemsSource="{Binding Artifacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ArtifactViewModel}">
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Mono}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Artifact.Path}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,8,4,0" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Border CornerRadius="6" Padding="12,10" Margin="0,12,0,0" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource OutlineButton}" Content="{DynamicResource Common_Close}" Margin="0,0,8,0" MinWidth="96" IsCancel="True"
                        Command="{Binding CloseCommand}" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="120" Command="{Binding CleanCommand}" IsDefault="True"
                        Visibility="{Binding IsDone, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE75C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Cleanup_Confirm}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
