<Window x:Class="Tezgah.App.Views.CloneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tezgah.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:CloneViewModel}"
        Style="{StaticResource DialogWindow}" Width="600" Title="{DynamicResource Clone_Title}">
    <StackPanel>
        <StackPanel Margin="24,22,24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,12" VerticalAlignment="Top" />
                <TextBlock Text="{DynamicResource Clone_Title}" Style="{StaticResource DialogTitle}" />
            </StackPanel>
            <TextBlock Text="{DynamicResource Clone_Url}" Style="{StaticResource Caption}" />
            <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
            <TextBlock Text="{DynamicResource Clone_UrlHint}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <TextBlock Text="{DynamicResource Clone_Target}" Style="{StaticResource Caption}" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding TargetParent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="{DynamicResource Common_Browse}" Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}" />
            </Grid>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding TargetPreview, Converter={StaticResource NullToVis}}">
                <Run Text="→ " /><Run Text="{Binding TargetPreview, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
            </TextBlock>

            <Border CornerRadius="6" Padding="8,6" Margin="0,12,0,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    Visibility="{Binding Log.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding Log}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" MaxHeight="140" />
            </Border>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
        </StackPanel>
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource OutlineButton}" Content="{DynamicResource Common_Cancel}" Margin="0,0,8,0" MinWidth="96" IsCancel="True"
                        Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True" Command="{Binding CloneCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Clone_Confirm}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
