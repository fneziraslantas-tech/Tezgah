    <!-- about -->
    <sys:String x:Key="About_Tooltip">About (F1)</sys:String>
    <sys:String x:Key="About_Title">About Tezgah</sys:String>
    <sys:String x:Key="About_Version">Version {0} · MIT licensed, open source</sys:String>
    <sys:String x:Key="About_Summary">Shows everything you installed, cloned from GitHub and forgot about in one place; runs it with one click and removes it without a trace when you no longer want it.</sys:String>
    <sys:String x:Key="About_HowTo">HOW TO USE</sys:String>
    <sys:String x:Key="About_HowScan">Scan</sys:String>
    <sys:String x:Key="About_HowScan_Body">Finds git repos, project folders, installed apps and command-line tools.</sys:String>
    <sys:String x:Key="About_HowSelect">Select</sys:String>
    <sys:String x:Key="About_HowSelect_Body">Search or filter and pick an item; details and commands appear on the right.</sys:String>
    <sys:String x:Key="About_HowRun">Run / Stop</sys:String>
    <sys:String x:Key="About_HowRun_Body">Run a project with one click, watch its output live, stop it with all its processes when you're done.</sys:String>
    <sys:String x:Key="About_HowClean">Free space</sys:String>
    <sys:String x:Key="About_HowClean_Body">Delete regenerable folders such as node_modules, .venv and bin/obj.</sys:String>
    <sys:String x:Key="About_HowRemove">Remove</sys:String>
    <sys:String x:Key="About_HowRemove_Body">Remove what you no longer want without a trace: project folder, app, shortcuts and leftovers.</sys:String>
    <sys:String x:Key="About_Safety">SAFETY</sys:String>
    <sys:String x:Key="About_Safety_Trust">A project's code never runs until you confirm you trust that folder.</sys:String>
    <sys:String x:Key="About_Safety_Inspect">Repos you have not trusted are inspected by reading their files only, without running any program.</sys:String>
    <sys:String x:Key="About_Safety_Recycle">Deleted folders go to the Recycle Bin by default, so you can restore them from there.</sys:String>
    <sys:String x:Key="About_Safety_Typed">Removing a repo with unsaved git work requires typing its name.</sys:String>
    <sys:String x:Key="About_Safety_Audit">Every removal is recorded in the audit log:</sys:String>
