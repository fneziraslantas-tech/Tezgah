<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, and every package id mapped to it (no dependency confusion with machine-level feeds). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
